name: '{{ alert_rule_display_name }}'
enabled: {{ enabled }}

labels:
  - PAAS_BUILTIN
  - {{ run_env }}
  - {{ alert_code }}

query:
  data_source: prometheus
  data_type: time_series
  query_configs:
  - metric: 'max by (bk_instance) ({{ redis_metric_name_prefix }}redis_instance_oom_killed{bk_app_code="{{ app_code }}", bk_module="{{ module_name }}", bk_env="{{ run_env }}"})'
    interval: 60 # 单位 s

detect: # 检测配置
  algorithm: # 检测算法
    fatal: # 告警级别[致命]
    - type: Threshold # 算法类型
      config: "{{ threshold_expr }}" # 算法配置

  trigger: 1/5/5 # 触发条件. 异常次数/检测周期数/恢复周期数

notice: # 通知配置
  interval: 120 # 通知收敛间隔(分钟)
  user_groups: # 通知组配置
  - '{{ notice_group_name }}'
  template:
{{ notice_template }}
