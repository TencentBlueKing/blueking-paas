# Dockerfile.local builds from this directory. Keep developer configuration and virtualenvs out
# of the context, including with legacy builders that ignore per-Dockerfile ignore files.
# Production builds from app-spark-api/ and uses that directory's Dockerfile.dockerignore.
**/.venv
**/.git
**/node_modules
**/__pycache__
**/*.pyc
**/.mypy_cache
**/.ruff_cache
**/.pytest_cache
**/.env
**/.env.*
**/settings_local.yaml
**/settings_files
**/values-production.yaml
**/manifests_ref
