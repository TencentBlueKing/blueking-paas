FROM python:3.14-slim-bookworm
ENV UV_NO_DEV=0
RUN mkdir -p ~/.pip && printf '[global]\nindex-url = https://mirrors.cloud.tencent.com/pypi/simple/\n' > ~/.pip/pip.conf
RUN pip install --no-cache-dir uv==0.10.0
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY app_spark_agent ./app_spark_agent
COPY tests ./tests
RUN uv sync --frozen \
    && uv pip install --python /app/.venv/bin/python 'mypy>=2.3.0,<3.0.0' 'pytest>=9.1.1' 'pytest-asyncio>=1.3.0' 'httpx>=0.28.1' \
    && /app/.venv/bin/python -c "import mypy, pytest"
ENV PATH="/app/.venv/bin:${PATH}"
