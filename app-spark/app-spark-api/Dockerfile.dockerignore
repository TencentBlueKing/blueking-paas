# Build context is this project directory. Never ship credentials, host virtualenvs,
# charts, tests or other non-runtime paths into the production image context.
**/.venv
**/.git
**/__pycache__/
**/*.pyc
**/.mypy_cache/
**/.ruff_cache/
**/.pytest_cache/
**/.env
**/.env.*
**/settings_local.yaml
**/settings_files/
**/values-production.yaml
**/manifests_ref/
**/charts/
**/tests/
**/docs/
