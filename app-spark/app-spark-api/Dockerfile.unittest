FROM python:3.14-slim-bookworm
ENV UV_NO_DEV=0
RUN mkdir -p ~/.pip && printf '[global]\nindex-url = https://mirrors.cloud.tencent.com/pypi/simple/\n' > ~/.pip/pip.conf
RUN pip install --no-cache-dir uv==0.10.0
WORKDIR /app
COPY pyproject.toml uv.lock README.md manage.py ./
COPY app_spark_api ./app_spark_api
COPY tests ./tests
# 部分单测会验证 Chart 中的配置 configmap 逻辑，因此一并加入
COPY charts ./charts
RUN uv sync --frozen \
    && uv pip install --python /app/.venv/bin/python 'mypy>=2.3.0,<3.0.0' 'pytest>=9.1.1' 'pytest-asyncio>=1.3.0' \
    && /app/.venv/bin/python -c "import mypy, pytest"
ENV PATH="/app/.venv/bin:${PATH}"
