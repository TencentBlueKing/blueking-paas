# 单测用的 MySQL 由流水线在旁边另起。那个容器要把 /var/lib/mysql 挂成 tmpfs 并加
# --innodb-use-native-aio=0：mysql 镜像把这个路径声明成 VOLUME，不挂载就会在构建机上留下匿名卷。
FROM python:3.14-slim-bookworm
ENV UV_NO_DEV=0
RUN mkdir -p ~/.pip && printf '[global]\nindex-url = https://mirrors.cloud.tencent.com/pypi/simple/\n' > ~/.pip/pip.conf
# Live Forgejo tests run git clone/push; the default suite does not need this binary.
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv==0.10.0
WORKDIR /app
COPY pyproject.toml uv.lock README.md manage.py ./
COPY app_spark_api ./app_spark_api
COPY tests ./tests
# 部分单测会验证 Chart 中的配置 configmap 逻辑，因此一并加入
COPY charts ./charts
# 单测会检查生产镜像与开发镜像的构建定义保持隔离
COPY Dockerfile Dockerfile.dockerignore Dockerfile.dev Dockerfile.dev.dockerignore ./
RUN uv sync --frozen \
    && uv pip install --python /app/.venv/bin/python 'mypy>=2.3.0,<3.0.0' 'pytest>=9.1.1' 'pytest-asyncio>=1.3.0' \
    && /app/.venv/bin/python -c "import mypy, pytest"
ENV PATH="/app/.venv/bin:${PATH}"
