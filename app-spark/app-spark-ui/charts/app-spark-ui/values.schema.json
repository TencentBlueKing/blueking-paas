{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "env": {
      "type": "object",
      "additionalProperties": false,
      "required": ["BK_SITE_URL", "BK_LOGIN_URL", "BK_TEMPLATE_URL"],
      "properties": {
        "BK_SITE_URL": { "type": "string", "pattern": "^(/[A-Za-z0-9_-]+)*/?$" },
        "BK_LOGIN_URL": { "type": "string" },
        "BK_TEMPLATE_URL": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "pathPrefix": { "type": "string", "pattern": "^/([A-Za-z0-9_-]+/)*[A-Za-z0-9_-]*$" },
        "path": false,
        "pathType": false
      }
    }
  }
}
